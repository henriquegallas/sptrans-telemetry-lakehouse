# Copy to .env and fill in. Never commit .env.
# Non-secret settings live in config/<ENV>.env; anything set here overrides them.

# Runtime mode: local | aws
ENV=local

# SPTrans Olho Vivo API — free token at https://www.sptrans.com.br/desenvolvedores/
SPTRANS_API_TOKEN=

# AWS (only used when ENV=aws)
AWS_PROFILE=
AWS_REGION=us-east-1
