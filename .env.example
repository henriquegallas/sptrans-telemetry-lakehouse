# Copy to .env and fill in. Never commit .env.

# Runtime mode: local | aws
ENV=local

# SPTrans Olho Vivo API — free token at https://www.sptrans.com.br/desenvolvedores/
SPTRANS_API_TOKEN=
SPTRANS_API_BASE_URL=https://api.olhovivo.sptrans.com.br/v2.1

# AWS (only used when ENV=aws)
AWS_PROFILE=
AWS_REGION=us-east-1
